<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone optimizer: grzyOptimizer.exe <folder>. Textures, and optionally LODs through Blender + Sollumz. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>grzyOptimizer</AssemblyName>
    <RootNamespace>grzyClothTool.Optimizer.Cli</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>..\grzyClothTool\Resources\grzyClothToolIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Same version as the app: both ship in the same release, and the self-update compares this FileVersion
       with <FileVersion> of grzyClothTool.csproj on master (bumped by scripts/bump-version.ps1). -->
  <PropertyGroup>
    <FileVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\grzyClothTool\grzyClothTool.csproj')), '(?&lt;=&lt;FileVersion&gt;)[^&lt;]+'))</FileVersion>
    <Version>$(FileVersion)</Version>
  </PropertyGroup>

  <!-- dotnet publish -c Release  ->  one self-contained grzyOptimizer.exe, no .NET install needed -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\grzyClothTool.Optimization\grzyClothTool.Optimization.csproj" />
    <ProjectReference Include="..\grzyClothTool.Shared\grzyClothTool.Shared.csproj" />
  </ItemGroup>

  <!-- Sollumz submodule (external/Sollumz), shipped next to the exe as sollumz/ for the "bundled" Sollumz mode.
       Initialize the submodule first; without it the CLI still builds and only the bundled mode is unavailable. -->
  <ItemGroup>
    <Content Include="..\external\Sollumz\**\*"
             Exclude="..\external\Sollumz\.git*;..\external\Sollumz\.git\**;..\external\Sollumz\.github\**;..\external\Sollumz\tests\**;..\external\Sollumz\**\__pycache__\**"
             LinkBase="sollumz"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CodeWalker.Core">
      <HintPath>..\packages\CodeWalker.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
