<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone texture optimizer: grzyOptimizer.exe <folder>. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>grzyOptimizer</AssemblyName>
    <RootNamespace>grzyClothTool.Optimizer.Cli</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>..\grzyClothTool\Resources\grzyClothToolIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- dotnet publish -c Release  ->  one self-contained grzyOptimizer.exe, no .NET install needed -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\grzyClothTool.Optimization\grzyClothTool.Optimization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CodeWalker.Core">
      <HintPath>..\packages\CodeWalker.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
