<Window x:Class="grzyClothTool.Views.AutoOptimizeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Performance Optimizer"
    Height="700"
    Width="950"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Brush50}"
    Foreground="{DynamicResource Brush900}">

    <Window.Resources>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource Brush100}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush300}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush900}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush200}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush400}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush900}"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Performance Optimizer"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush900}"/>
            <TextBlock x:Name="SubtitleText"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush600}"
                       Margin="0,4,0,0"/>
            <TextBlock Text="Selected textures are resized to the nearest power of 2 within your resolution limits (Settings), compressed when uncompressed and get a full mip map chain. Changes are applied during resource build and can be undone per texture."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush600}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush100}"
                BorderBrush="{DynamicResource Brush300}"
                BorderThickness="1"
                CornerRadius="3">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Drawable" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Grid.Column="2" Text="Texture" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Grid.Column="3" Text="Current" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Grid.Column="4" Text="Optimized" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Grid.Column="5" Text="Why" FontWeight="SemiBold" FontSize="11"/>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CandidatesControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush250}"
                                        BorderThickness="0,1,0,0"
                                        Padding="12,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="CandidateCheckBox_Click"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DrawableName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding AddonName}" FontSize="10" Foreground="{DynamicResource Brush600}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TextureName}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{DynamicResource Brush600}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding CurrentText}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="4" Text="{Binding TargetText}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="5" Text="{Binding ReasonsText}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Brush700}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   x:Name="ManualIssuesTitle"
                   Style="{StaticResource SectionTitle}"
                   Margin="4,16,0,6"/>

        <Border Grid.Row="3"
                Background="{DynamicResource Brush100}"
                BorderBrush="{DynamicResource Brush300}"
                BorderThickness="1"
                CornerRadius="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ManualIssuesControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush250}"
                                    BorderThickness="0,1,0,0"
                                    Padding="12,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DrawableName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding AddonName}" FontSize="10" Foreground="{DynamicResource Brush600}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Select all" Click="SelectAll_Click" Style="{StaticResource ActionButton}"/>
                <Button Content="Select none" Click="SelectNone_Click" Style="{StaticResource ActionButton}"/>
                <Button Content="Rescan" Click="Rescan_Click" Style="{StaticResource ActionButton}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ApplyButton"
                        Content="Optimize selected"
                        Click="Apply_Click"
                        Style="{StaticResource ActionButton}"/>
                <Button Content="Close"
                        Click="Close_Click"
                        Style="{StaticResource ActionButton}"
                        Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
