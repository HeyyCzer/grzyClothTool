<Window x:Class="grzyClothTool.Views.LodGeneratorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:c="clr-namespace:grzyClothTool.Controls"
    mc:Ignorable="d"
    Title="LOD Generator"
    Height="720"
    Width="1050"
    MinHeight="560"
    MinWidth="820"
    WindowStartupLocation="CenterOwner"
    Closing="Window_Closing"
    Background="{DynamicResource Brush50}"
    Foreground="{DynamicResource Brush900}">

    <Window.Resources>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource Brush100}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush300}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush900}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush200}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush400}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big packs have thousands of rows: keep the list virtualized. -->
        <Style TargetType="ItemsControl" x:Key="VirtualizedList">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="LOD Generator"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush900}"/>
            <TextBlock x:Name="SubtitleText"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush600}"
                       Margin="0,4,0,0"/>
            <TextBlock Text="Blender + Sollumz decimate the High model of the selected drawables into the missing Medium/Low LODs. Only the new LOD models are added: textures, shaders and the High model stay untouched. The result is saved to the project assets; the original files are not modified. Clothes with physics (.yld) are skipped."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush600}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel x:Name="SettingsPanel">
                    <c:ModernLabelTextBox
                        x:Name="BlenderPathBox"
                        Label="Blender (empty = auto-detect)"
                        IsFileSelection="True"
                        FileExtension=".exe"
                        HorizontalAlignment="Stretch"
                        ToolTip="blender.exe, Blender 4.2 or newer. Empty uses the newest Blender in Program Files, then the PATH."/>
                    <TextBlock x:Name="BlenderDetectedText"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush600}"
                               Margin="4,4,0,0"/>

                    <GroupBox Header="Sollumz" Margin="0,14,0,0" Style="{DynamicResource FixedGroupBox}">
                        <StackPanel>
                            <c:ModernLabelRadioButton
                                x:Name="SollumzInstalledRadio"
                                Margin="5,5,5,0"
                                GroupName="sollumz"
                                Label="Installed in my Blender"
                                ToolTip="The Sollumz add-on enabled in your Blender."
                                MyBtnSelectEvent="SollumzMode_Changed"/>
                            <c:ModernLabelRadioButton
                                x:Name="SollumzBundledRadio"
                                Margin="5,1,5,0"
                                GroupName="sollumz"
                                Label="Bundled with grzyClothTool"
                                ToolTip="The Sollumz copy shipped with grzyClothTool, loaded into a clean Blender. Your add-ons are not touched."
                                MyBtnSelectEvent="SollumzMode_Changed"/>
                            <c:ModernLabelRadioButton
                                x:Name="SollumzFolderRadio"
                                Margin="5,1,5,5"
                                GroupName="sollumz"
                                Label="From a folder"
                                ToolTip="Any Sollumz add-on folder, loaded like the bundled one."
                                MyBtnSelectEvent="SollumzMode_Changed"/>
                            <c:ModernLabelTextBox
                                x:Name="SollumzFolderBox"
                                Label="Sollumz folder"
                                IsFolderSelection="True"
                                Margin="5,0,5,5"
                                HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </GroupBox>

                    <c:ModernLabelTextBox
                        x:Name="MediumPercentBox"
                        Label="Medium LOD size (% of High)"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"/>
                    <c:ModernLabelTextBox
                        x:Name="LowPercentBox"
                        Label="Low LOD size (% of High)"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"/>
                    <c:ModernLabelTextBox
                        x:Name="WorkersBox"
                        Label="Blender processes at the same time"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        ToolTip="Each Blender process takes a few hundred MB of memory."/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1"
                    Background="{DynamicResource Brush100}"
                    BorderBrush="{DynamicResource Brush300}"
                    BorderThickness="1"
                    CornerRadius="3">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Drawable" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="High polygons" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Grid.Column="3" Text="Missing" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" FontSize="11"/>
                    </Grid>

                    <ItemsControl x:Name="CandidatesControl" Style="{StaticResource VirtualizedList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush250}"
                                        BorderThickness="0,1,0,0"
                                        Padding="12,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="4*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="CandidateCheckBox_Click"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DrawableName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding AddonName}" FontSize="10" Foreground="{DynamicResource Brush600}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding HighPolygons}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding MissingText}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Brush700}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="SelectionButtons" Grid.Column="0" Orientation="Horizontal">
                <Button Content="Select all" Click="SelectAll_Click" Style="{StaticResource ActionButton}"/>
                <Button Content="Select none" Click="SelectNone_Click" Style="{StaticResource ActionButton}"/>
                <Button Content="Rescan" Click="Rescan_Click" Style="{StaticResource ActionButton}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,16,0">
                <ProgressBar x:Name="Progress"
                             Height="10"
                             Minimum="0"
                             Maximum="1"
                             Background="{DynamicResource Brush200}"
                             BorderBrush="{DynamicResource Brush100}"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="ProgressText"
                           FontSize="11"
                           Foreground="{DynamicResource Brush700}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="GenerateButton"
                        Content="Generate LODs"
                        Click="Generate_Click"
                        Style="{StaticResource ActionButton}"/>
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Click="Cancel_Click"
                        Visibility="Collapsed"
                        Style="{StaticResource ActionButton}"/>
                <Button x:Name="CloseButton"
                        Content="Close"
                        Click="Close_Click"
                        Style="{StaticResource ActionButton}"
                        Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
